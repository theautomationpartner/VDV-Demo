# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# storage local (roles/usuarios) - no versionar
/data/storage.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Lo copia scripts/copiar-worker-pdf.js en cada build, para que no se
# desincronice de la version de pdfjs-dist instalada.
public/pdf.worker.min.mjs
