# Copiar este archivo a .env.local y completar los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Capa 2 (whitelist de emails) + Capa 3 (2FA / TOTP) - ver SeguidadApp.md y
# lib/server/auth-guard.js. Off por defecto: se activa recien cuando las 3
# variables de abajo esten configuradas.
AUTH_LAYERS_ENABLED=false

# Connection string de Neon (Vercel -> proyecto -> pestaña Storage -> Create
# Database -> Neon; en local: Project Settings -> Environment Variables -> copiar
# el valor de DATABASE_URL, o `vercel env pull .env.local` si el proyecto esta
# linkeado). Correr una vez `npm run migrate` para crear las tablas.
DATABASE_URL=

# Clave para cifrar los secretos TOTP en la tabla mfa_usuarios. Generar con:
# openssl rand -hex 32   (o: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MFA_ENCRYPTION_KEY=

# Clave para firmar el JWT de sesion MFA de corta duracion (~12hs) que el cliente
# reenvia en el header X-Mfa-Session. Generar igual que MFA_ENCRYPTION_KEY.
MFA_SESSION_SECRET=

# Modo demo: la app sirve datos 100% inventados (lib/server/demo-data.js) en vez de
# pegarle a monday.com, y no exige el sessionToken del iframe de monday - pensado
# para un link publico de prueba sin exponer ningun dato real. Si esta en "true",
# el resto de las variables de abajo (MONDAY_*) no hacen falta.
# OJO: hay que definir LAS DOS (el server y el cliente las leen por separado).
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Token de API de monday.com (Perfil > Administracion > API en monday.com).
# Se usa SOLO server-side (app/api/monday/*) - nunca se expone al navegador.
MONDAY_API_TOKEN=

# Clave con la que monday firma el sessionToken que manda el frontend en cada
# pedido (ver lib/monday-auth.js y lib/server/monday-guard.js). Se saca del
# developer center de la app, seccion "Basic Information": puede ser el
# "Signing Secret" o el "Client Secret" segun el caso - hay reportes de
# "invalid signature" cruzados, probar ambos en desarrollo y dejar anotado
# aca cual funciono.
MONDAY_SIGNING_SECRET=

# app_id de esta app en monday (mismo developer center). Si se completa, el
# guard rechaza sessionTokens emitidos para otra app instalada en la cuenta.
MONDAY_APP_ID=

# board_id real de cada tablero en monday.com (se ve en la URL del board:
# https://<cuenta>.monday.com/boards/<ESTE_NUMERO>).
# Sin esto, las pantallas de esa app muestran un estado "falta configuracion".
MONDAY_BOARD_ORDENES_DE_COMPRA_MAXXA=
MONDAY_BOARD_FACTURAS_IA=
MONDAY_BOARD_BASE_DE_DATOS_MATERIALES=
MONDAY_BOARD_INGRESOS=
MONDAY_BOARD_VALES=
MONDAY_BOARD_PROVEEDORES=
MONDAY_BOARD_PAGOS_VDV=
MONDAY_BOARD_FLUJO_CONTRATACION_SUBCONTRATO=
MONDAY_BOARD_ESTADOS_DE_PAGO_SUBCONTRATOS=
